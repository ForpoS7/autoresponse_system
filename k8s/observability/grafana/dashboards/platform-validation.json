{
  "title": "Platform Validation",
  "uid": "autoresponse-platform-val",
  "description": "Task 6: HTTP latency, Circuit Breaker ejections, Rate Limiter hits, Istio error rates",
  "tags": ["autoresponse", "istio", "circuit-breaker", "ratelimit"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "query": "label_values(istio_requests_total, destination_service_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate (by status)",
      "description": "Общий RPS разбитый по HTTP-статусам. Рост 5xx при fault injection — ожидаемо.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (response_code) (rate(istio_requests_total{destination_service_name=~\"$service\"}[1m]))",
          "legendFormat": "HTTP {{response_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "HTTP 5.." }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": "HTTP 2.." }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": "HTTP 429" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 2,
      "title": "Request Latency P50 / P95 / P99",
      "description": "Рост P99 говорит о медленных запросах. Spike при fault injection из-за retry.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (destination_service_name, le) (rate(istio_request_duration_milliseconds_bucket{destination_service_name=~\"$service\"}[1m])))",
          "legendFormat": "p50 {{destination_service_name}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (destination_service_name, le) (rate(istio_request_duration_milliseconds_bucket{destination_service_name=~\"$service\"}[1m])))",
          "legendFormat": "p95 {{destination_service_name}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (destination_service_name, le) (rate(istio_request_duration_milliseconds_bucket{destination_service_name=~\"$service\"}[1m])))",
          "legendFormat": "p99 {{destination_service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 3,
      "title": "Circuit Breaker — Outlier Detection Ejections/s",
      "description": "Количество выброшенных подов в секунду. Ненулевое значение = CB сработал. Должно появиться через ~5 ошибок (consecutiveGatewayErrors=5 в DestinationRule).",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster_name) (rate(envoy_cluster_outlier_detection_ejections_enforced_total[1m]))",
          "legendFormat": "ejections/s — {{cluster_name}}"
        },
        {
          "refId": "B",
          "expr": "sum by (cluster_name) (envoy_cluster_outlier_detection_ejections_active)",
          "legendFormat": "active ejections — {{cluster_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "color": { "fixedColor": "red", "mode": "fixed" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Rate Limiter — Over-Limit Requests/s",
      "description": "Запросы, заблокированные Envoy Rate Limit Service (Valkey backend). /auth → 5/min, /api → 60/min.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (domain) (rate(ratelimit_service_rate_limit_over_limit[1m]))",
          "legendFormat": "over_limit — {{domain}}"
        },
        {
          "refId": "B",
          "expr": "sum by (domain) (rate(ratelimit_service_rate_limit_total_hits[1m]))",
          "legendFormat": "total hits — {{domain}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "over_limit.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 10,
      "title": "Error Rate %",
      "type": "stat",
      "description": "Доля 5xx от всех запросов за последние 5 минут. >1% = проблема.",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(istio_requests_total{response_code=~\"5..\",destination_service_name=~\"$service\"}[5m])) / sum(rate(istio_requests_total{destination_service_name=~\"$service\"}[5m])) * 100",
          "legendFormat": "Error %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 11,
      "title": "Total RPS",
      "type": "stat",
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(istio_requests_total{destination_service_name=~\"$service\"}[1m]))",
          "legendFormat": "RPS"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 12,
      "title": "CB Active Ejections",
      "type": "stat",
      "description": "Сколько подов сейчас выброшено Circuit Breaker'ом. 0 = CB закрыт.",
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(envoy_cluster_outlier_detection_ejections_active)",
          "legendFormat": "Active Ejections"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 13,
      "title": "Rate Limited (last 1m)",
      "type": "stat",
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ratelimit_service_rate_limit_over_limit[1m]))",
          "legendFormat": "Blocked Requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 20,
      "title": "Error Rate by Service",
      "type": "bargauge",
      "description": "5xx rate по каждому сервису. autoapply-service будет красным при fault injection.",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (destination_service_name) (rate(istio_requests_total{response_code=~\"5..\"}[2m]))",
          "legendFormat": "{{destination_service_name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    }
  ]
}
